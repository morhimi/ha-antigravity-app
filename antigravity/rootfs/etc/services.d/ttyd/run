#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant App: Antigravity CLI
# Starts the ttyd Ingress Web Terminal on port 8099
# ==============================================================================

set -euo pipefail

export HOME="/root"
export SHELL="/bin/bash"
export TERM="xterm-256color"
export SSH_CONNECTION="127.0.0.1 0 127.0.0.1 22"
export PATH="/data/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

workspace_dir="$(bashio::config 'workspace_dir')"
if [ ! -d "${workspace_dir}" ]; then
    mkdir -p "${workspace_dir}"
fi

cd "${workspace_dir}"

bashio::log.info "Starting Antigravity Ingress web terminal (ttyd) on port 8099..."

exec /usr/bin/ttyd \
    --port 8099 \
    --interface 0.0.0.0 \
    --writable \
    -t fontSize=14 \
    -t titleFixed="Antigravity CLI" \
    /usr/local/bin/agy-terminal
