#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Take down the S6 supervision tree when ttyd fails unexpectedly
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
    bashio::log.warning "ttyd exited with code ${APP_EXIT_CODE}; halting app..."
    echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi

bashio::log.info "ttyd service restarting..."
