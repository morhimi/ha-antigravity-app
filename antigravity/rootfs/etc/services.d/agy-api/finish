#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Restart agy-api service if it exits unexpectedly
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -eq 0 ]] || [[ "${APP_EXIT_CODE}" -eq 256 ]]; then
    exit 0
fi

bashio::log.info "agy-api service stopped (exit ${APP_EXIT_CODE}); restarting in 2 seconds..."
sleep 2
