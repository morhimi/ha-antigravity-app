#!/usr/bin/env bash
# ==============================================================================
# Interactive welcome shell and first-time authentication helper
# ==============================================================================

export HOME="/root"
export SHELL="/bin/bash"
export TERM="xterm-256color"
export SSH_CONNECTION="127.0.0.1 0 127.0.0.1 22"
export PATH="/data/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

clear
printf "\033[1;36m==================================================================\033[0m\n"
printf "\033[1;36m  Google Antigravity CLI (agy) — Home Assistant App\033[0m\n"
printf "\033[1;36m==================================================================\033[0m\n"
printf "  CLI Version : \033[1;32m%s\033[0m\n" "$(/usr/local/bin/agy --version 2>/dev/null || echo 'unknown')"
printf "  Workspace   : \033[1;33m%s\033[0m\n" "$(pwd)"
printf "\033[1;36m------------------------------------------------------------------\033[0m\n"
/usr/local/bin/agy remote-control status 2>&1 || true
printf "\033[1;36m------------------------------------------------------------------\033[0m\n"
printf "  Commands:\n"
printf "    \033[1magy\033[0m                        Start interactive Antigravity session\n"
printf "    \033[1magy -c\033[0m                     Continue most recent conversation\n"
printf "    \033[1magy remote-control status\033[0m  Check Remote Control daemon status\n"
printf "    \033[1mha core check\033[0m              Validate Home Assistant configuration\n"
printf "\033[1;36m==================================================================\033[0m\n\n"

# Use print mode (-p) for initial sign-in so the OAuth URL is emitted as a
# single unbroken soft-wrapped line in ttyd (instead of TUI box-wrapped rows).
while [ ! -f /data/.gemini/antigravity-cli/antigravity_state.pbtxt ] && [ -z "${GEMINI_API_KEY:-}" ]; do
    printf "\033[1;33mFirst-time setup: Sign in with your Google Account below.\033[0m\n"
    printf "\033[0;36mClick the full URL below, sign in, and paste the authorization code:\033[0m\n\n"
    /usr/local/bin/agy -p "Reply with Ready." || true
    echo ""
done

exec /bin/bash -l
